{
  "name": "aetherx-mobile",
  "version": "1.2.9",
  "private": true,
  "description": "AetherX Android client",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HanLoney/AetherX.git",
    "directory": "frontend/mobile"
  },
  "bugs": "https://github.com/HanLoney/AetherX/issues",
  "homepage": "https://github.com/HanLoney/AetherX#readme",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-capacitor-android.mjs",
    "dev": "vite",
    "dev:cloud": "vite --mode cloud",
    "build": "vue-tsc --noEmit && vite build",
    "build:cloud": "vue-tsc --noEmit && vite build --mode cloud",
    "test": "vitest run",
    "android:sync": "node scripts/sync-android.mjs local",
    "android:sync:cloud": "node scripts/sync-android.mjs cloud",
    "android:test": "npm run android:sync && cd android && gradlew.bat testLocalDebugUnitTest",
    "android:release": "npm run android:sync && cd android && gradlew.bat testLocalDebugUnitTest assembleLocalRelease bundleLocalRelease",
    "android:lan-release": "npm run android:sync && cd android && gradlew.bat testLocalDebugUnitTest assembleLocalLanRelease",
    "android:cloud:release": "npm run android:sync:cloud && cd android && gradlew.bat testCloudDebugUnitTest assembleCloudRelease bundleCloudRelease",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/barcode-scanner": "^3.1.0",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.0.0",
    "@capacitor/device": "^8.0.3",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.1",
    "@lucide/vue": "^1.24.0",
    "emoji-picker-element": "^1.29.1",
    "markdown-it": "^14.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^5.7.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.0"
  }
}
