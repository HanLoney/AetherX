{
  "name": "aetherx-desktop",
  "version": "1.2.6",
  "description": "AetherX modular personal assistant desktop client",
  "main": "main.js",
  "author": "Xuanxiaotech",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HanLoney/AetherX.git",
    "directory": "frontend/desktop"
  },
  "bugs": "https://github.com/HanLoney/AetherX/issues",
  "homepage": "https://github.com/HanLoney/AetherX#readme",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "verify:backend": "node ../../scripts/verify-packaged-backend.js dist/win-unpacked",
    "verify:signature": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/verify-windows-signature.ps1 dist/win-unpacked/AetherX.exe dist/AetherX-*.exe",
    "dist:dir": "electron-builder --win dir --publish never && npm run verify:backend",
    "dist": "npm run dist:installer && npm run dist:portable",
    "dist:signed": "npm run dist && npm run verify:signature",
    "dist:installer": "electron-builder --win nsis --publish never --config.artifactName=\"${productName}-安装版-${version}-${arch}.${ext}\"",
    "dist:portable": "electron-builder --win portable --publish never --config.artifactName=\"${productName}-免安装版-${version}-${arch}.${ext}\""
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.xuanxiaotech.todo",
    "productName": "AetherX",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "desktop-control.js",
      "hub-runtime.js",
      "sync-runtime.js",
      "api-client.js",
      "auth-store.js",
      "preload.js",
      "auth.html",
      "auth.css",
      "auth.js",
      "home.html",
      "home.css",
      "app-shell.css",
      "interface-settings.js",
      "clock.js",
      "device-manager.js",
      "connection-center.js",
      "mobile-hub-status.js",
      "pairing-endpoints.js",
      "windows-network-profile.js",
      "emoji-picker.js",
      "qr-code.js",
      "home.js",
      "ai-providers.js",
      "module-settings.js",
      "xuan-mood.js",
      "mood-heartbeat.js",
      "reminder-composer.js",
      "reminder-engine.js",
      "journal-writer.js",
      "journal-illustrator.js",
      "dream-writer.js",
      "album-writer.js",
      "markdown-renderer.js",
      "modules.html",
      "modules.css",
      "modules.js",
      "memory.html",
      "memory.css",
      "memory.js",
      "album.html",
      "album.css",
      "album.js",
      "album-pager.js",
      "dream.html",
      "dream.css",
      "dream.js",
      "image-generator.html",
      "image-generator.css",
      "image-generator.js",
      "wallet.html",
      "wallet.css",
      "wallet.js",
      "profile.html",
      "profile.css",
      "profile.js",
      "journal-pager.js",
      "gallery-layout.js",
      "growth-language.js",
      "avatar-cropper.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "app-icon-rounded.png"
    ],
    "extraResources": [
      {
        "from": "../../backend",
        "to": "backend",
        "filter": [
          "src/**/*",
          "scripts/ensure-adb-reverse.js",
          "package.json",
          "README.md"
        ]
      },
      {
        "from": "../../backend/node_modules/jpeg-js",
        "to": "backend/node_modules/jpeg-js",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../launcher/tailscale-manager.js",
        "to": "connection-runtime/tailscale-manager.js"
      },
      {
        "from": "windows-firewall.ps1",
        "to": "connection-runtime/windows-firewall.ps1"
      },
      {
        "from": "tool-registry.js",
        "to": "agent-tools/tool-registry.js"
      },
      {
        "from": "todo-tools.js",
        "to": "agent-tools/todo-tools.js"
      },
      {
        "from": "wallet-tools.js",
        "to": "agent-tools/wallet-tools.js"
      },
      {
        "from": "memory-tools.js",
        "to": "agent-tools/memory-tools.js"
      },
      {
        "from": "journal-illustrator.js",
        "to": "agent-tools/journal-illustrator.js"
      },
      {
        "from": "journal-tools.js",
        "to": "agent-tools/journal-tools.js"
      },
      {
        "from": "album-tools.js",
        "to": "agent-tools/album-tools.js"
      },
      {
        "from": "dream-tools.js",
        "to": "agent-tools/dream-tools.js"
      },
      {
        "from": "image-tools.js",
        "to": "agent-tools/image-tools.js"
      }
    ],
    "win": {
      "icon": "app-icon-rounded.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "include": "installer.nsh",
      "oneClick": false,
      "packElevateHelper": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AetherX"
    }
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
